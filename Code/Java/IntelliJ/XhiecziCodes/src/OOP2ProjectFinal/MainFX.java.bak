        sidebarBtn("🚨 Recent Alerts", this::showAlertsTable);
        sidebarBtn("🔔 Notifications", this::showNotificationCenterPanel);

        sidebarSection("ACCOUNT");
        sidebarBtn("👤 Profile", this::showModernProfilePanel);
        sidebarBtn("⚙ Settings", this::showSettingsPanel);
        sidebarBtn("ℹ About", this::showAboutPanel);
        sidebarBtn("❔ Help", this::showHelpPanel);
        addLogoutButton();

        showWelcomePanel(user);
    }

    private void buildDashboard(String roleLabel, String username) {
        dashboardRoot = new BorderPane();
        dashboardRoot.setStyle("-fx-background-color: " + DARKER_BG + ";");

        // Modern Header
        Label logo = new Label("SAKAY CEBU");
        logo.setFont(Font.font("System", FontWeight.BOLD, 18));
        logo.setStyle("-fx-text-fill: " + GREEN_PRIMARY + ";");
        
        Label roleBadge = new Label(roleLabel.toUpperCase());
        roleBadge.setStyle("-fx-background-color: " + GREEN_PRIMARY + "20; -fx-text-fill: " + GREEN_PRIMARY + 
                          "; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 4 12; -fx-background-radius: 20;");
        
        headerTitle = new Label(username);
        headerTitle.setStyle("-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: " + TEXT_PRIMARY + ";");
        
        // Status indicator
        Label statusDot = new Label("●");
        statusDot.setStyle("-fx-text-fill: " + GREEN_PRIMARY + "; -fx-font-size: 10px;");
        Label statusText = new Label("Connected");
        statusText.setStyle("-fx-text-fill: " + TEXT_SECONDARY + "; -fx-font-size: 11px;");
        HBox statusBox = new HBox(4, statusDot, statusText);
        
        Circle avatar = new Circle(20, Color.web(GREEN_PRIMARY));
        Label avatarInit = new Label(username.substring(0, 1).toUpperCase());
        avatarInit.setStyle("-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;");
        StackPane avatarPane = new StackPane(avatar, avatarInit);

        Region spacer = new Region();
        HBox.setHgrow(spacer, Priority.ALWAYS);

        HBox headerContent = new HBox(16, logo, roleBadge, spacer, headerTitle, statusBox, avatarPane);
        headerContent.setAlignment(Pos.CENTER_LEFT);

        headerBox = new VBox(headerContent);
        headerBox.setPadding(new Insets(16, 24, 16, 24));
        headerBox.setStyle("-fx-background-color: " + DARK_BG + "; -fx-border-color: " + BORDER_COLOR + "; -fx-border-width: 0 0 1 0;");
        dashboardRoot.setTop(headerBox);

        // Sidebar
        sidebar = new VBox(6);
        sidebar.setPadding(new Insets(20, 12, 20, 12));
        sidebar.setPrefWidth(240);
        sidebar.setStyle("-fx-background-color: " + DARK_BG + "; -fx-border-color: " + BORDER_COLOR + "; -fx-border-width: 0 1 0 0;");
        
        ScrollPane sidebarScroll = new ScrollPane(sidebar);
        sidebarScroll.setFitToWidth(true);
        sidebarScroll.setHbarPolicy(ScrollPane.ScrollBarPolicy.NEVER);
        sidebarScroll.setStyle("-fx-background: transparent; -fx-background-color: transparent;");
        dashboardRoot.setLeft(sidebarScroll);

        // Content Area
        contentArea = new VBox(20);
        contentArea.setPadding(new Insets(24));
        contentArea.setStyle("-fx-background-color: " + DARKER_BG + ";");
        
        ScrollPane contentScroll = new ScrollPane(contentArea);
        contentScroll.setFitToWidth(true);
        contentScroll.setHbarPolicy(ScrollPane.ScrollBarPolicy.NEVER);
        contentScroll.setStyle("-fx-background: transparent; -fx-background-color: transparent;");
        dashboardRoot.setCenter(contentScroll);

        mainStage.setScene(new Scene(dashboardRoot, 1280, 760));
    }

    // ═══════════════════════════════════════════════════════════════════════
    // MODERN ROUTE DASHBOARD - Card-based UI
    // ═══════════════════════════════════════════════════════════════════════

    private void showModernRouteDashboard() {
        contentArea.getChildren().clear();

        Label title = new Label("Route Dashboard");
        title.setStyle("-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: " + TEXT_PRIMARY + ";");
        
        Label subtitle = new Label("Real-time vehicle status across all routes");
        subtitle.setStyle("-fx-font-size: 13px; -fx-text-fill: " + TEXT_SECONDARY + ";");

        // Filter by route
        ComboBox<String> routeFilter = new ComboBox<>();
        routeFilter.getItems().add("All Routes");
        monitoring.getRoutes().forEach(r -> routeFilter.getItems().add(r.routeId() + " – " + r.routeName()));
        routeFilter.setValue("All Routes");
        routeFilter.setMaxWidth(280);
        routeFilter.setPrefHeight(40);
        styleComboBox(routeFilter);

        Button refreshBtn = modernButton("Refresh", GREEN_PRIMARY, 140);
        Label statusMsg = new Label();

        // FlowPane for vehicle cards
        FlowPane cardsContainer = new FlowPane();
        cardsContainer.setHgap(16);
        cardsContainer.setVgap(16);
        cardsContainer.setPadding(new Insets(16, 0, 16, 0));

        Runnable loadCards = () -> {
            cardsContainer.getChildren().clear();
            String filter = routeFilter.getValue();
            String filterRouteId = "All Routes".equals(filter) ? null : filter.split("–")[0].trim();
            
            List<PublicVehicle> vehicles = monitoring.getAllVehicles();
            boolean hasData = false;
            
            for (PublicVehicle v : vehicles) {
                if (filterRouteId != null && !filterRouteId.equalsIgnoreCase(v.routeId())) continue;
                if (v.routeId() == null && filterRouteId != null) continue;
                hasData = true;
                cardsContainer.getChildren().add(createVehicleCard(v));
            }
            
            if (!hasData) {
                Label emptyLabel = new Label("No vehicles found" + (filterRouteId != null ? " on this route" : ""));
                emptyLabel.setStyle("-fx-text-fill: " + TEXT_SECONDARY + "; -fx-font-size: 14px;");
                cardsContainer.getChildren().add(emptyLabel);
            }
        };

        refreshBtn.setOnAction(e -> loadCards.run());
        routeFilter.setOnAction(e -> loadCards.run());

        loadCards.run();

        ScrollPane scrollPane = new ScrollPane(cardsContainer);
        scrollPane.setFitToWidth(true);
        scrollPane.setStyle("-fx-background: transparent; -fx-background-color: transparent;");
        scrollPane.setHbarPolicy(ScrollPane.ScrollBarPolicy.NEVER);

        VBox headerBox = new VBox(8, title, subtitle, new HBox(12, routeFilter, refreshBtn, statusMsg));
        
        VBox card = createModernCard(headerBox, scrollPane);
        VBox.setVgrow(scrollPane, Priority.ALWAYS);
        VBox.setVgrow(card, Priority.ALWAYS);
        contentArea.getChildren().add(card);
    }

    private VBox createVehicleCard(PublicVehicle v) {
        VBox card = new VBox(12);
        card.setPadding(new Insets(18));
        card.setPrefWidth(280);
        card.setStyle("-fx-background-color: " + CARD_BG + "; -fx-background-radius: 16; -fx-border-color: " + BORDER_COLOR + "; -fx-border-radius: 16;");
        
        // Hover effect
        card.setOnMouseEntered(e -> card.setStyle("-fx-background-color: " + CARD_HOVER + "; -fx-background-radius: 16; -fx-border-color: " + GREEN_PRIMARY + "40; -fx-border-radius: 16;"));
        card.setOnMouseExited(e -> card.setStyle("-fx-background-color: " + CARD_BG + "; -fx-background-radius: 16; -fx-border-color: " + BORDER_COLOR + "; -fx-border-radius: 16;"));
        
        // Vehicle icon and type
        String vehicleIcon = v instanceof Bus ? "🚌" : (v instanceof ModernJeep ? "🚎" : "🚐");
        HBox header = new HBox(10);
        Label iconLabel = new Label(vehicleIcon);
        iconLabel.setStyle("-fx-font-size: 28px;");
        
        VBox infoBox = new VBox(2);
        Label idLabel = new Label(v.vehicleId());
        idLabel.setStyle("-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: " + TEXT_PRIMARY + ";");
        Label typeLabel = new Label(v.getVehicleType());
        typeLabel.setStyle("-fx-font-size: 12px; -fx-text-fill: " + GREEN_PRIMARY + ";");
        infoBox.getChildren().addAll(idLabel, typeLabel);
        
        Region spacer = new Region();
        HBox.setHgrow(spacer, Priority.ALWAYS);
        
        // Status badge
        String status = monitoring.getVehicleStatus(v);
        String statusColor = status.equals("NORMAL") ? GREEN_PRIMARY : (status.equals("OVERSPEED") || status.equals("FULL/OVERLOAD") ? ACCENT_RED : ACCENT_ORANGE);
        Label statusBadge = new Label("● " + status);
        statusBadge.setStyle("-fx-text-fill: " + statusColor + "; -fx-font-size: 11px; -fx-font-weight: bold;");
        
        header.getChildren().addAll(iconLabel, infoBox, spacer, statusBadge);
        
        // Route info
        Label routeLabel = new Label(v.routeId() != null ? v.routeId() + " – " + monitoring.getRouteById(v.routeId()).routeName() : "Unassigned");
        routeLabel.setStyle("-fx-text-fill: " + TEXT_SECONDARY + "; -fx-font-size: 12px;");
        
        // Stats row
        HBox stats = new HBox(16);
        stats.setAlignment(Pos.CENTER);
        
        VBox speedBox = new VBox(2);
        Label speedVal = new Label(v.hasLocation() ? String.format("%.0f", v.speedKmh()) : "--");
        speedVal.setStyle("-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: " + TEXT_PRIMARY + ";");
        Label speedLabel = new Label("km/h");
        speedLabel.setStyle("-fx-text-fill: " + TEXT_MUTED + "; -fx-font-size: 10px;");
        speedBox.getChildren().addAll(speedVal, speedLabel);
        speedBox.setAlignment(Pos.CENTER);
        
        VBox paxBox = new VBox(2);
        int pct = v.capacity() > 0 ? (int)((double)v.passengerCount() / v.capacity() * 100) : 0;
        String pctColor = pct >= 90 ? ACCENT_RED : (pct >= 60 ? ACCENT_ORANGE : GREEN_PRIMARY);
        Label paxVal = new Label(v.passengerCount() + "/" + v.capacity());
        paxVal.setStyle("-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: " + pctColor + ";");
        Label paxLabel = new Label("passengers");
        paxLabel.setStyle("-fx-text-fill: " + TEXT_MUTED + "; -fx-font-size: 10px;");
        paxBox.getChildren().addAll(paxVal, paxLabel);
        paxBox.setAlignment(Pos.CENTER);
        
        VBox etaBox = new VBox(2);
        String etaText = "N/A";
        if (v.hasLocation() && v.routeId() != null) {
            Route route = monitoring.getRouteById(v.routeId());
            if (route != null && !route.stops().isEmpty()) {
                Stop nearest = monitoring.getNearestStopOnRoute(v, route);
                if (nearest != null) {
                    double eta = monitoring.calculateEtaMinutes(v, nearest);
                    etaText = eta >= 0 ? String.format("%.0f", eta) : "N/A";
                }
            }
        }
        Label etaVal = new Label(etaText);
        etaVal.setStyle("-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: " + ACCENT_BLUE + ";");
        Label etaLabel = new Label("min to next");
        etaLabel.setStyle("-fx-text-fill: " + TEXT_MUTED + "; -fx-font-size: 10px;");
        etaBox.getChildren().addAll(etaVal, etaLabel);
        etaBox.setAlignment(Pos.CENTER);
        
        stats.getChildren().addAll(speedBox, paxBox, etaBox);
        
        // Plate number
        Label plateLabel = new Label("Plate: " + v.plateNumber());
        plateLabel.setStyle("-fx-text-fill: " + TEXT_MUTED + "; -fx-font-size: 11px;");
        
        card.getChildren().addAll(header, routeLabel, separator(), stats, plateLabel);
        return card;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // MODERN SEARCH BY ROUTE
    // ═══════════════════════════════════════════════════════════════════════

    private void showModernSearchByRoute() {
        contentArea.getChildren().clear();

        Label title = new Label("Search by Route");
        title.setStyle("-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: " + TEXT_PRIMARY + ";");

        // Route selector with modern styling
        ComboBox<Route> routeBox = new ComboBox<>();
        routeBox.getItems().addAll(monitoring.getRoutes());
        routeBox.setPromptText("Select a route");
        routeBox.setMaxWidth(400);
        routeBox.setPrefHeight(48);
        styleComboBox(routeBox);

        Button searchBtn = modernButton("Search Route", GREEN_PRIMARY, 180);
        Label msg = new Label();

        // Results container
        VBox resultsContainer = new VBox(16);
        resultsContainer.setPadding(new Insets(16, 0, 0, 0));

        searchBtn.setOnAction(e -> {
            resultsContainer.getChildren().clear();
            Route route = routeBox.getValue();
            if (route == null) {
                showError(msg, "Please select a route.");
                return;
            }
            msg.setText("");

            // Route info card
            VBox routeInfoCard = new VBox(12);
            routeInfoCard.setPadding(new Insets(20));
            routeInfoCard.setStyle("-fx-background-color: " + CARD_BG + "; -fx-background-radius: 16; -fx-border-color: " + BORDER_COLOR + "; -fx-border-radius: 16;");
            
            HBox routeHeader = new HBox(12);
            Label routeIcon = new Label("🛣");
            routeIcon.setStyle("-fx-font-size: 32px;");
            VBox routeText = new VBox(4);
            Label routeIdLabel = new Label(route.routeId());
            routeIdLabel.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: " + TEXT_PRIMARY + ";");
            Label routeNameLabel = new Label(route.routeName());
            routeNameLabel.setStyle("-fx-font-size: 14px; -fx-text-fill: " + GREEN_PRIMARY + ";");
            routeText.getChildren().addAll(routeIdLabel, routeNameLabel);
            routeHeader.getChildren().addAll(routeIcon, routeText);
            
            // Stops preview
            Label stopsTitle = new Label("Stops on this route:");
            stopsTitle.setStyle("-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: " + TEXT_SECONDARY + ";");
            FlowPane stopsFlow = new FlowPane(8, 8);
            for (Stop stop : route.stops()) {
                Label stopBadge = new Label("● " + stop.stopName());
                stopBadge.setStyle("-fx-background-color: " + CARD_HOVER + "; -fx-text-fill: " + TEXT_SECONDARY + "; -fx-padding: 6 12; -fx-background-radius: 20; -fx-font-size: 11px;");
                stopsFlow.getChildren().add(stopBadge);
            }
            
            routeInfoCard.getChildren().addAll(routeHeader, separator(), stopsTitle, stopsFlow);
            resultsContainer.getChildren().add(routeInfoCard);

            // Vehicles on route
            List<PublicVehicle> vehicles = monitoring.getVehiclesByRoute(route.routeId());
            if (vehicles.isEmpty()) {
                Label noVehicles = new Label("No vehicles currently assigned to this route.");
                noVehicles.setStyle("-fx-text-fill: " + TEXT_SECONDARY + "; -fx-font-size: 14px; -fx-padding: 20;");
                resultsContainer.getChildren().add(noVehicles);
                return;
            }

            Label vehiclesTitle = new Label("Active Vehicles (" + vehicles.size() + ")");
            vehiclesTitle.setStyle("-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: " + TEXT_PRIMARY + "; -fx-padding: 16 0 8 0;");
            resultsContainer.getChildren().add(vehiclesTitle);

            // Vehicle cards in FlowPane
            FlowPane vehicleCards = new FlowPane();
            vehicleCards.setHgap(16);
            vehicleCards.setVgap(16);
            
            for (PublicVehicle v : vehicles) {
                vehicleCards.getChildren().add(createCompactVehicleCard(v, route));
            }
            
            resultsContainer.getChildren().add(vehicleCards);
        });

        VBox card = createModernCard(title, routeBox, searchBtn, msg, resultsContainer);
        VBox.setVgrow(resultsContainer, Priority.ALWAYS);
        VBox.setVgrow(card, Priority.ALWAYS);
        contentArea.getChildren().add(card);
    }

    private VBox createCompactVehicleCard(PublicVehicle v, Route route) {
    VBox card = new VBox(10);
    card.setPadding(new Insets(14));
    card.setPrefWidth(260);
    card.setStyle("-fx-background-color: " + CARD_BG + "; -fx-background-radius: 14; -fx-border-color: " + BORDER_COLOR + "; -fx-border-radius: 14;");
    
    String vehicleIcon = v instanceof Bus ? "🚌" : (v instanceof ModernJeep ? "🚎" : "🚐");
    HBox header = new HBox(10);
    Label iconLabel = new Label(vehicleIcon);
    iconLabel.setStyle("-fx-font-size: 24px;");
    
    VBox infoBox = new VBox(2);
    Label idLabel = new Label(v.vehicleId());
    idLabel.setStyle("-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: " + TEXT_PRIMARY + ";");
    Label plateLabel = new Label(v.plateNumber());
    plateLabel.setStyle("-fx-font-size: 11px; -fx-text-fill: " + TEXT_MUTED + ";");
    infoBox.getChildren().addAll(idLabel, plateLabel);
    
    Region spacer = new Region();
    HBox.setHgrow(spacer, Priority.ALWAYS);
    
    String status = monitoring.getVehicleStatus(v);
    String statusColor = status.equals("NORMAL") ? GREEN_PRIMARY : (status.equals("OVERSPEED") || status.equals("FULL/OVERLOAD") ? ACCENT_RED : ACCENT_ORANGE);
    Label statusBadge = new Label("●");
    statusBadge.setStyle("-fx-text-fill: " + statusColor + "; -fx-font-size: 14px;");
    
    header.getChildren().addAll(iconLabel, infoBox, spacer, statusBadge);
    
    Stop lastStop = route.stops().isEmpty() ? null : route.stops().get(route.stops().size() - 1);
    String etaText = "N/A";
    if (v.hasLocation() && lastStop != null) {
        double eta = monitoring.calculateEtaMinutes(v, lastStop);
        etaText = eta >= 0 ? String.format("%.0f min", eta) : "N/A";
    }
    
    HBox stats = new HBox(12);  // FIXED: changed from HBar to HBox
    stats.setAlignment(Pos.CENTER);
    Label speedLabel = new Label(v.hasLocation() ? String.format("%.0f km/h", v.speedKmh()) : "--");
    speedLabel.setStyle("-fx-text-fill: " + TEXT_SECONDARY + "; -fx-font-size: 12px;");
    Label paxLabel = new Label(v.hasLocation() ? v.passengerCount() + "/" + v.capacity() : "--");
    paxLabel.setStyle("-fx-text-fill: " + TEXT_SECONDARY + "; -fx-font-size: 12px;");
    Label etaDisplay = new Label("ETA: " + etaText);
    etaDisplay.setStyle("-fx-text-fill: " + ACCENT_BLUE + "; -fx-font-size: 12px; -fx-font-weight: bold;");
    
    stats.getChildren().addAll(speedLabel, paxLabel, etaDisplay);
    
    card.getChildren().addAll(header, stats);
    return card;
}

    // ═══════════════════════════════════════════════════════════════════════
    // LIVE MAP - With Real GPS, Auto-refresh, and Proper Road Lines
    // ═══════════════════════════════════════════════════════════════════════

    private void showLiveMapPanel() {
    contentArea.getChildren().clear();

    Label title = new Label("Live Vehicle Map");
    title.setStyle("-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: " + TEXT_PRIMARY + ";");
    
    Label subtitle = new Label("Real-time vehicle positions | Cebu City");
    subtitle.setStyle("-fx-font-size: 13px; -fx-text-fill: " + TEXT_SECONDARY + ";");

    // Controls
    ComboBox<String> routeFilter = new ComboBox<>();
    routeFilter.getItems().add("All Routes");
    monitoring.getRoutes().forEach(r -> routeFilter.getItems().add(r.routeId() + " – " + r.routeName()));
    routeFilter.setValue("All Routes");
    routeFilter.setMaxWidth(300);
    routeFilter.setPrefHeight(40);
    styleComboBox(routeFilter);

    ToggleButton gpsToggle = new ToggleButton("📍 Live GPS Mode");
    gpsToggle.setStyle("-fx-background-color: " + CARD_BG + "; -fx-text-fill: " + TEXT_SECONDARY + "; -fx-background-radius: 20; -fx-padding: 8 16;");
    gpsToggle.setSelected(isRealGPSMode);
    gpsToggle.setOnAction(e -> {
        isRealGPSMode = gpsToggle.isSelected();
        refreshLiveMap();
    });

    Button refreshBtn = modernButton("Refresh", GREEN_PRIMARY, 120);
    Label mapMsg = new Label();
    mapMsg.setStyle("-fx-text-fill: " + ACCENT_RED + ";");

    // Create WebView with explicit size
    liveMapWebView = new WebView();
    liveMapWebView.setPrefSize(900, 550);
    liveMapWebView.setMinHeight(500);
    liveMapWebView.setMaxHeight(Double.MAX_VALUE);
    
    // Setup JavaScript bridge
    liveMapWebView.getEngine().getLoadWorker().stateProperty().addListener((obs, oldState, newState) -> {
        if (newState == javafx.concurrent.Worker.State.SUCCEEDED) {
            JSObject window = (JSObject) liveMapWebView.getEngine().executeScript("window");
            window.setMember("javaApp", new GPSBridge());
        }
    });

    Runnable loadMap = () -> {
        String filter = routeFilter.getValue();
        String filterRouteId = "All Routes".equals(filter) ? null : filter.split("–")[0].trim();
        
        StringBuilder vehicleMarkers = new StringBuilder();
        StringBuilder routePolylines = new StringBuilder();
        StringBuilder gpsScript = new StringBuilder();

        // Draw route polylines with detailed road points
        for (Route route : monitoring.getRoutes()) {
            if (filterRouteId != null && !route.routeId().equalsIgnoreCase(filterRouteId)) continue;
            
            List<double[]> pathPoints = routePaths.get(route.routeId());
            if (pathPoints != null && pathPoints.size() >= 2) {
                StringBuilder latlngs = new StringBuilder("[");
                for (double[] point : pathPoints) {
                    latlngs.append(String.format("[%f,%f],", point[0], point[1]));
                }
                latlngs.deleteCharAt(latlngs.length() - 1).append("]");
                routePolylines.append(String.format(
                        "L.polyline(%s,{color:'#00C853',weight:5,opacity:0.7,smoothFactor:1}).addTo(map);%n",
                        latlngs
                ));
            }
            
            // Add stop markers
            for (Stop stop : route.stops()) {
                vehicleMarkers.append(String.format(
                        "L.circleMarker([%f,%f],{radius:6,color:'#00C853',fillColor:'#00C853',fillOpacity:0.8}).addTo(map).bindTooltip('%s',{permanent:false});%n",
                        stop.lat(), stop.lon(), stop.stopName().replace("'", "\\'")
                ));
            }
        }

        // Add vehicle markers
        int vehicleCount = 0;
        for (PublicVehicle v : monitoring.getAllVehicles()) {
            if (!v.hasLocation()) continue;
            if (filterRouteId != null && !filterRouteId.equalsIgnoreCase(v.routeId())) continue;
            
            String type = v.getVehicleType();
            String emoji = type.contains("Bus") ? "🚌" : type.contains("Modern") ? "🚎" : "🚐";
            String color = type.contains("Bus") ? "#448AFF" : type.contains("Modern") ? "#FF9800" : "#00C853";
            
            int pct = v.capacity() > 0 ? (int)((double)v.passengerCount() / v.capacity() * 100) : 0;
            String status = pct >= 90 ? "FULL" : pct >= 60 ? "BUSY" : "OK";
            
            vehicleMarkers.append(String.format(
                    "L.marker([%f,%f],{icon:L.divIcon({" +
                    "html:'<div style=\"background:%s;width:44px;height:44px;border-radius:50%%;display:flex;" +
                    "align-items:center;justify-content:center;font-size:22px;" +
                    "border:3px solid rgba(255,255,255,0.3);box-shadow:0 4px 16px rgba(0,0,0,0.4);\">" +
                    "%s</div>'," +
                    "className:'',iconSize:[44,44],iconAnchor:[22,22]})}).addTo(map)" +
                    ".bindPopup('<div style=\"font-family:sans-serif;min-width:180px;\">" +
                    "<b>%s %s</b><br>" +
                    "<span style=\"color:#00C853;\">●</span> %s<br>" +
                    "Plate: %s<br>" +
                    "Route: %s<br>" +
                    "Speed: %.0f km/h<br>" +
                    "Passengers: %d/%d (%d%%)<br>" +
                    "<span style=\"color:%s;\">▼ Status: %s</span>" +
                    "</div>');%n",
                    v.lat(), v.lon(),
                    color, emoji,
                    emoji, v.vehicleId(),
                    status,
                    v.plateNumber(),
                    v.routeId() != null ? v.routeId() : "Unassigned",
                    v.speedKmh(),
                    v.passengerCount(), v.capacity(), pct,
                    pct >= 90 ? ACCENT_RED : (pct >= 60 ? ACCENT_ORANGE : GREEN_PRIMARY),
                    status
            ));
            vehicleCount++;
        }

        // GPS tracking script for real device location
        if (isRealGPSMode && currentUser instanceof Operator) {
            gpsScript.append("""
                if (navigator.geolocation) {
                    navigator.geolocation.watchPosition(
                        function(position) {
                            var lat = position.coords.latitude;
                            var lng = position.coords.longitude;
                            var accuracy = position.coords.accuracy;
                            var speed = position.coords.speed || 0;
                            window.javaApp.receiveGPS(lat, lng, accuracy, speed);
                            
                            if (window.userMarker) {
                                window.userMarker.setLatLng([lat, lng]);
                            } else {
                                window.userMarker = L.marker([lat, lng], {
                                    icon: L.divIcon({
                                        html: '<div style="background:#00C853;width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;border:3px solid white;box-shadow:0 4px 16px rgba(0,0,0,0.4);">📍</div>',
                                        className: '',
                                        iconSize: [38, 38],
                                        iconAnchor: [19, 19]
                                    })
                                }).addTo(map).bindPopup('<b>Your Location</b><br>Accuracy: ' + Math.round(accuracy) + 'm').openPopup();
                            }
                        },
                        function(error) {
                            console.log('GPS Error:', error);
                        },
                        { enableHighAccuracy: true, maximumAge: 0, timeout: 5000 }
                    );
                }
            """);
        }

        String html = """
        <!DOCTYPE html>
        <html>
        <head>
            <meta charset="utf-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
            <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
            <style>
                * {
                    margin: 0;
                    padding: 0;
                    box-sizing: border-box;
                }
                html, body {
                    width: 100%;
                    height: 100%;
                    margin: 0;
                    padding: 0;
                }
                #map {
                    width: 100%;
                    height: 100%;
                    background: #1a1a2e;
                }
                .leaflet-popup-content-wrapper {
                    background: #1E1E1E;
                    color: #FFFFFF;
                    border-radius: 12px;
                    border: 1px solid #2C2C2C;
                }
                .leaflet-popup-tip {
                    background: #1E1E1E;
                }
                .leaflet-popup-content {
                    margin: 12px 16px;
                    color: #FFFFFF;
                }
                .leaflet-control-zoom a {
                    background: #1E1E1E;
                    color: #FFFFFF;
                    border: 1px solid #2C2C2C;
                }
                .legend {
                    position: absolute;
                    bottom: 20px;
                    left: 20px;
                    background: rgba(30,30,30,0.95);
                    backdrop-filter: blur(8px);
                    color: #B0B0B0;
                    padding: 12px 18px;
                    border-radius: 12px;
                    font: 12px/1.5 sans-serif;
                    border: 1px solid #2C2C2C;
                    z-index: 1000;
                    pointer-events: none;
                }
                .legend span {
                    display: inline-block;
                    width: 12px;
                    height: 12px;
                    border-radius: 50%;
                    margin-right: 6px;
                }
            </style>
        </head>
        <body>
            <div id="map"></div>
            <div class="legend">
                <div><span style="background:#00C853;"></span> Jeepney</div>
                <div><span style="background:#FF9800;"></span> Modern Jeep</div>
                <div><span style="background:#448AFF;"></span> Bus</div>
                <div><span style="background:#00C853;border-radius:2px;"></span> Route Path</div>
                <div><span style="background:#00C853;border-radius:0;"></span> Stop</div>
                %s
            </div>
            <script>
                // Initialize map with Cebu City center
                var map = L.map('map').setView([10.3157, 123.8854], 13);
                
                // Add dark map tiles
                L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                    subdomains: 'abcd',
                    maxZoom: 19,
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> & CARTO'
                }).addTo(map);
                
                // Force map to refresh after loading
                setTimeout(function() {
                    map.invalidateSize();
                }, 100);
                setTimeout(function() {
                    map.invalidateSize();
                }, 500);
                setTimeout(function() {
                    map.invalidateSize();
                }, 1000);
                
                %s
                %s
            </script>
        </body>
        </html>
        """.formatted(
                isRealGPSMode && currentUser instanceof Operator ? "<div style='margin-top:8px;'><span style='background:#00C853;'></span> 📍 Your GPS Location</div>" : "",
                routePolylines.toString(),
                vehicleMarkers.toString() + gpsScript.toString()
        );

        liveMapWebView.getEngine().loadContent(html);
        
        if (vehicleCount == 0 && filterRouteId == null && !isRealGPSMode) {
            showError(mapMsg, "No vehicles have GPS data. Start simulation or send a ping.");
        } else {
            mapMsg.setText("");
        }
    };

    refreshBtn.setOnAction(e -> loadMap.run());
    routeFilter.setOnAction(e -> loadMap.run());
    gpsToggle.setOnAction(e -> loadMap.run());

    // Auto-refresh every 3 seconds
    if (mapAutoRefresh != null) mapAutoRefresh.stop();
    mapAutoRefresh = new Timeline(new KeyFrame(Duration.seconds(3), e -> loadMap.run()));
    mapAutoRefresh.setCycleCount(Timeline.INDEFINITE);
    mapAutoRefresh.play();

    HBox controls = new HBox(12, routeFilter, refreshBtn, gpsToggle, mapMsg);
    controls.setAlignment(Pos.CENTER_LEFT);

    VBox card = createModernCard(title, subtitle, controls, liveMapWebView);
    VBox.setVgrow(liveMapWebView, Priority.ALWAYS);
    VBox.setVgrow(card, Priority.ALWAYS);
    contentArea.getChildren().add(card);
}


    private void refreshLiveMap() {
        if (liveMapWebView != null) {
            showLiveMapPanel();
        }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // GPS TRACKING PANEL
    // ═══════════════════════════════════════════════════════════════════════

    private void showGPSTrackingPanel() {
    contentArea.getChildren().clear();

    Label title = new Label("GPS Tracking Mode");
    title.setStyle("-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: " + TEXT_PRIMARY + ";");

    VBox infoCard = new VBox(16);
    infoCard.setPadding(new Insets(24));
    infoCard.setStyle("-fx-background-color: " + CARD_BG + "; -fx-background-radius: 16; -fx-border-color: " + BORDER_COLOR + "; -fx-border-radius: 16;");

    Label modeStatus = new Label(isRealGPSMode ? "● GPS Tracking is ACTIVE" : "○ GPS Tracking is INACTIVE");
    modeStatus.setStyle("-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: " + (isRealGPSMode ? GREEN_PRIMARY : TEXT_SECONDARY) + ";");

    ToggleButton enableGPS = new ToggleButton(isRealGPSMode ? "Disable GPS Tracking" : "Enable GPS Tracking");
    enableGPS.setStyle("-fx-background-color: " + (isRealGPSMode ? ACCENT_RED : GREEN_PRIMARY) + "; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 24; -fx-padding: 12 24;");
    
    enableGPS.setOnAction(e -> {
        isRealGPSMode = enableGPS.isSelected();
        enableGPS.setText(isRealGPSMode ? "Disable GPS Tracking" : "Enable GPS Tracking");
        enableGPS.setStyle("-fx-background-color: " + (isRealGPSMode ? ACCENT_RED : GREEN_PRIMARY) + "; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 24; -fx-padding: 12 24;");
        modeStatus.setText(isRealGPSMode ? "● GPS Tracking is ACTIVE" : "○ GPS Tracking is INACTIVE");
        modeStatus.setStyle("-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: " + (isRealGPSMode ? GREEN_PRIMARY : TEXT_SECONDARY) + ";");
        addActivityLog(isRealGPSMode ? "Enabled real GPS tracking" : "Disabled real GPS tracking");
        
        if (liveMapWebView != null) refreshLiveMap();
    });

    Label instruction = new Label("When enabled, your device's GPS will be used to track the showcase vehicle (V-SHOWCASE) in real-time.\n\n" +
            "This simulates how Grab/Angkas tracks driver locations.\n\n" +
            "Make sure to allow location permissions when prompted by your browser.");
    instruction.setStyle("-fx-text-fill: " + TEXT_SECONDARY + "; -fx-font-size: 13px; -fx-wrap-text: true;");

    infoCard.getChildren().addAll(modeStatus, enableGPS, separator(), instruction);

    contentArea.getChildren().add(createModernCard(title, infoCard));
}

